rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 관리자 역할 확인 함수
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // 서브매니저 이상 권한 확인
    function isManager() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'submanager'];
    }

    // 예약 데이터: 읽기는 누구나(직원 공유 일정표용), 쓰기는 매니저 이상만
    match /bookings/{bookingId} {
      allow read: if true;
      allow write: if isManager();
    }

    // 정산/결제 데이터: 관리자만
    match /settlements/{docId} {
      allow read, write: if isAdmin();
    }

    // 시스템 설정 (텔레그램 Chat ID 등): 관리자만
    match /settings/{docId} {
      allow read, write: if isAdmin();
    }

    // 사용자 역할 정보
    match /users/{userId} {
      // 본인 데이터는 읽기 가능 (로그인 시 role 조회를 위해)
      allow read: if request.auth != null && request.auth.uid == userId;
      // 쓰기는 관리자만 (role 설정)
      allow write: if isAdmin();
    }

    // 체크인 설정: 매니저 이상 읽기, 관리자만 쓰기
    match /checkinSettings/{docId} {
      allow read: if isManager();
      allow write: if isAdmin();
    }

    // 직원 명단 (1~10번 이름 등록): 읽기는 누구나, 쓰기는 매니저 이상
    match /staffMembers/{docId} {
      allow read: if true;
      allow write: if isManager();
    }

    // 직원 휴무 기록: 읽기는 누구나(공개 일정표용), 쓰기는 매니저 이상
    match /staffDaysOff/{docId} {
      allow read: if true;
      allow write: if isManager();
    }

    // 나머지 모든 컬렉션: 기본 차단
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
